# API Keys opcionales
# BreachDirectory (RapidAPI) - Para verificacion de telefono
# Registrate gratis en https://rapidapi.com/rohan-patra/api/breachdirectory
# BREACHDIRECTORY_API_KEY=tu_api_key_aqui

# GitHub Personal Access Token - Sube el rate limit de 60 a 5000 req/hr
# en el OSINT de GitHub (busqueda de emails por username). No requiere
# scopes especiales (solo lectura de datos publicos).
# Crea uno en https://github.com/settings/tokens
# GITHUB_TOKEN=tu_token_aqui

# HIBP (Have I Been Pwned) API Key - Habilita la busqueda de brechas por
# email (endpoint breachedaccount, es de pago). El chequeo de passwords
# (Pwned Passwords, k-anonymity) es publico y NO usa esta key.
# Consiguela en https://haveibeenpwned.com/API/Key
# HIBP_API_KEY=tu_api_key_aqui
